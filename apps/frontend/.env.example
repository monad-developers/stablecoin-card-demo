# Comma-separated RPC URLs. Settlement transactions are submitted to all of them.
BUN_PUBLIC_RPC_URL=http://127.0.0.1:8545
BUN_PUBLIC_CHAIN_ID=31337
BUN_PUBLIC_ACQUIRER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Monad testnet example:
# BUN_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
# BUN_PUBLIC_CHAIN_ID=10143

# Server-only keys used by setup and API endpoints. For Monad testnet, replace
# these with funded testnet keys. They can be the same key for a demo.
DEMO_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEMO_ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Fill these with the values printed by `bun run setup` in apps/frontend.
BUN_PUBLIC_STABLECOIN_ADDRESS=
BUN_PUBLIC_STABLECOIN_ASSET_ADDRESS=
BUN_PUBLIC_STABLECOIN_ADAPTER_ADDRESS=
BUN_PUBLIC_AAVE_STABLECOIN_ADDRESS=
BUN_PUBLIC_AAVE_ORACLE_ADDRESS=
BUN_PUBLIC_AAVE_SPOKE_ADDRESS=
BUN_PUBLIC_AAVE_TAKER_POSITION_MANAGER_ADDRESS=
BUN_PUBLIC_AAVE_ADAPTER_ADDRESS=
BUN_PUBLIC_AAVE_DEBT_RESERVE_ID=
